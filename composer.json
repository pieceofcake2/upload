{
    "name": "pieceofcake2/upload",
    "description": "CakePHP plugin to handle file uploading sans ridiculous automagic",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "upload", "files", "behavior"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "suggest": {
        "ext-gd": "For GD-based thumbnail creation",
        "ext-imagick": "For Imagick-based thumbnail creation"
    },
    "replace": {
        "josegonzalez/cakephp-upload": "^1.0"
    },
    "autoload-dev": {
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Upload"
    }
}
